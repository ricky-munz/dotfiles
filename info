#!/bin/bash

# Description: Displays information about dotfiles setup.

dotfiles_dir="$HOME/dotfiles"
file_count=$(ls "$dotfiles_dir" | wc -l)
today=$(date +%Y-%m-%d)

echo "=== Dotfile Info ==="
echo "User: $USER"
echo "Dotfiles location: $dotfiles_dir"
echo "Files tracked: $file_count"
echo "Date: $today"

